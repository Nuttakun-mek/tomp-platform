{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["hnd1"],
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/web/api/$1"
    },
    { "src": "/admin/pilot-smoke-test", "status": 307, "headers": { "Location": "/superadmin/dev-tools/smoke-test" } },
    { "src": "/admin/data-quality", "status": 307, "headers": { "Location": "/superadmin/dev-tools/data-quality" } },
    { "src": "/admin/enterprise-readiness", "status": 307, "headers": { "Location": "/superadmin/dev-tools/readiness" } },
    { "src": "/admin/operations", "status": 307, "headers": { "Location": "/superadmin/dev-tools/runbook" } },
    { "src": "/admin", "status": 307, "headers": { "Location": "/superadmin" } },
    { "src": "/live-test", "status": 307, "headers": { "Location": "/superadmin/dev-tools/live-test" } },
    { "src": "/pilot-checklist", "status": 307, "headers": { "Location": "/superadmin/dev-tools/pilot-checklist" } },
    {
      "src": "/projects/new",
      "dest": "/apps/web/projects/new"
    },
    {
      "src": "/projects/([^/]+)/assignments",
      "dest": "/apps/web/assignments?projectId=$1"
    },
    {
      "src": "/projects/([^/]+)",
      "dest": "/apps/web/project?projectId=$1"
    },
    {
      "src": "/driver/([^/]+)",
      "dest": "/apps/web/driver?token=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/web/$1"
    }
  ]
}
