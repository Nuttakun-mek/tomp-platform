AIRPORT_TRANSFER_SYNC_SECRET=

# Server-side only. Used by scripts/bootstrap-production-admin.mjs.
# Do not hardcode real accounts in source code.
TOMP_BOOTSTRAP_ADMIN_EMAIL=
TOMP_BOOTSTRAP_ADMIN_PASSWORD=
TOMP_BOOTSTRAP_ADMIN_NAME=
