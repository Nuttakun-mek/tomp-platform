{
  "name": "tomp-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tomp/web",
    "dev:mobile": "npm --prefix apps/mobile-driver run start",
    "mobile:android": "npm --prefix apps/mobile-driver run android",
    "mobile:ios": "npm --prefix apps/mobile-driver run ios",
    "build": "npm run build -w @tomp/web",
    "lint": "npm run lint -w @tomp/web",
    "typecheck": "npm run typecheck -w @tomp/web",
    "test": "npm run test -w @tomp/web && npm run test -w @tomp/driver-core",
    "test:watch": "npm run test:watch -w @tomp/web",
    "security:env": "node scripts/check-public-env.mjs",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
